; Engine configuration file.
; Cardboard Kingdom 3D — Godot 4.7, mobile renderer, billboard sprites.
config_version=5

[application]
config/name="Cardboard Kingdom 3D"
config/description="A homeless survival sim: stay warm, stay fed, build your kingdom. Free, offline."
run/main_scene="res://main.tscn"
config/icon="res://icon.png"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="viewport"

[rendering]
renderer/rendering_method="mobile"
